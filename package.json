{
  "name": "teasury",
  "private": true,
  "version": "0.1.0",
  "description": "Sistema Integral de Tesorería",
  "workspaces": [
    "backend",
    "desktop"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev -w @teasury/backend\" \"npm run dev -w @teasury/desktop\"",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}